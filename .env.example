SESSION_SECRET=7c9f2e8a4d1b6f0c3a5e9d7b2f8c1a6e4b0d9f3c7a2e5b8d1c6f0a9e3d7b5c2a

# Application Discord (https://discord.com/developers/applications > OAuth2)
DISCORD_CLIENT_ID=1545799033233215610
DISCORD_CLIENT_SECRET=v3yx-FgkUaTY5SV2Pvj9Z6pcrhKNcJtA
# Optionnel : sinon calculée depuis le domaine. À ajouter aussi dans Discord > OAuth2 > Redirects.
# Exemple : https://dunkerquerp.vercel.app/api/auth/callback/discord
DISCORD_REDIRECT_URI=https://dunkerquerp.vercel.app/api/auth/callback/discord

# Webhook Discord qui reçoit les candidatures (et les demandes d'unban si APPEALS_WEBHOOK_URL est vide)
DISCORD_APPLICATIONS_WEBHOOK_URL=
# Optionnel : webhook séparé pour les demandes d'unban
APPEALS_WEBHOOK_URL=https://discord.com/api/webhooks/1558715459598032956/X-DEaenFOU0phedXF2E9pX4FynnHemZYixLcjrw_KEgHO3f__jDXqMBKtcCkrVJXoYpc

# Lien avec le bot : mêmes valeurs que API_TOKEN et l'adresse de l'API du bot
BOT_API_URL=http://169.58.54.102:25530
BOT_API_TOKEN=di_8fK3mQ9xV2nR7pL5wZ6aT4yH1cB0sD8j
# Mettre 1 seulement si l'API du bot est en http:// (le jeton circule alors en clair : préférer https)
